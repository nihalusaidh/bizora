{
  "appId": "app.bizora.operating",
  "productName": "BIZORA",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "out/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icons/icon-512.svg"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/icons/icon-512.svg",
    "uninstallerIcon": "public/icons/icon-512.svg"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icons/icon-512.svg"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icons/icon-512.svg"
  }
}
